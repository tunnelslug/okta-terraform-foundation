# Copy to backend.hcl (gitignored) or pass via:
#   terraform init -backend-config=backend.hcl.example

bucket         = "YOUR_COMPANY-terraform-state"
key            = "okta/prod/identity/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "terraform-locks"
encrypt        = true

